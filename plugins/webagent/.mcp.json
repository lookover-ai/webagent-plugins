{
  "mcpServers": {
    "lookover-qa": {
      "type": "http",
      "url": "${user_config.api_url}/mcp/qa"
    },
    "lookover-qa-key": {
      "type": "http",
      "url": "${user_config.api_url}/mcp/qa?auth=key",
      "headers": {
        "Authorization": "Bearer ${user_config.api_key}"
      }
    },
    "lookover-browser": {
      "type": "http",
      "url": "${user_config.api_url}/mcp/browser"
    },
    "lookover-browser-key": {
      "type": "http",
      "url": "${user_config.api_url}/mcp/browser?auth=key",
      "headers": {
        "Authorization": "Bearer ${user_config.api_key}"
      }
    }
  }
}
