{
  "mcpServers": {
    "webagent": {
      "type": "http",
      "url": "${user_config.api_url}/mcp"
    },
    "webagent-key": {
      "type": "http",
      "url": "${user_config.api_url}/mcp?auth=key",
      "headers": {
        "Authorization": "Bearer ${user_config.api_key}"
      }
    }
  }
}
